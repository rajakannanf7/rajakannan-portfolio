rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only these accounts may edit the site. Firebase lets anyone holding the
    // public web config create an email/password account, so "signed in" alone
    // is not enough. Keep this list in sync with ADMIN_EMAILS on Vercel.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email.lower() in ['rajakannanf7@gmail.com'];
    }

    // The portfolio is public to read; only the admin may change it.
    match /{col}/{doc} {
      allow read: if col in ['projects', 'shoots', 'skills', 'labs', 'settings'];
      allow write: if isAdmin() && col in ['projects', 'shoots', 'skills', 'labs', 'settings'];
    }

    // Enquiries: the public may CREATE one (the contact form) but never read them.
    match /enquiries/{doc} {
      allow create: if request.resource.data.keys().hasAll(['name','email','message'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 200
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() < 5000;
      allow read, update, delete: if isAdmin();
    }
  }
}

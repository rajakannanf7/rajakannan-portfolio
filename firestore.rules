rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone may read the portfolio. Only a signed-in user may change it.
    match /projects/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /photos/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /labs/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Enquiries: the public may CREATE one, but never read anyone else's.
    // Only you, signed in, can read or change them.
    match /enquiries/{doc} {
      allow create: if request.resource.data.keys().hasAll(['name','email','message'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 200
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() < 5000;
      allow read, update, delete: if request.auth != null;
    }
  }
}

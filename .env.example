# ---- Firebase (Project settings -> General -> Your apps -> Web app) ----
# Public values: they ship to every visitor's browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Admin + media (server only) ----
# Comma-separated emails allowed to use /admin and upload. Must match firestore.rules.
ADMIN_EMAILS=
# GitHub repo that stores uploaded images, as owner/name, and its branch.
MEDIA_REPO=rajakannanf7/rajakannan-media
MEDIA_BRANCH=main
# SECRET. Fine-grained token with Contents: Read and write on MEDIA_REPO only.
# Set it in Vercel yourself; never commit it.
GITHUB_TOKEN=
